+
+        let mut close_requested = false;
+        ctx.show_viewport_immediate(viewport_id, builder, |mixer_ctx, _class| {
+            let viewport_info = mixer_ctx.input(|input| input.viewport().clone());
+            if viewport_info.close_requested() {
+                close_requested = true;
+            }
+
+            let mut rescued_offscreen = false;
+            if let (Some(outer_rect), Some(monitor_size)) =
+                (viewport_info.outer_rect, viewport_info.monitor_size)
+            {
+                if !mixer_rect_is_visible_on_monitor(outer_rect, monitor_size) {
+                    let width = outer_rect.width().min(monitor_size.x.max(320.0));
+                    let height = outer_rect.height().min(monitor_size.y.max(240.0));
+                    let x = ((monitor_size.x - width) * 0.5).max(0.0);
+                    let y = ((monitor_size.y - height) * 0.5).max(0.0);
+                    self.mixer_window_position = None;
+                    self.mixer_window_size = sanitize_window_size(Some([width, height]));
+                    mixer_ctx.send_viewport_cmd(egui::ViewportCommand::OuterPosition(
