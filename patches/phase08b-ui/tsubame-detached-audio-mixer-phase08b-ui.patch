+fn mixer_rect_is_visible_on_monitor(outer_rect: egui::Rect, monitor_size: egui::Vec2) -> bool {
+    if monitor_size.x <= 1.0 || monitor_size.y <= 1.0 {
+        return true;
+    }
+    if !rects_intersect(
+        [outer_rect.min.x, outer_rect.min.y],
+        [outer_rect.width(), outer_rect.height()],
+        [0.0, 0.0],
+        [monitor_size.x, monitor_size.y],
+    ) {
+        return false;
+    }
+
+    let visible_left = outer_rect.min.x.max(0.0);
+    let visible_top = outer_rect.min.y.max(0.0);
+    let visible_right = outer_rect.max.x.min(monitor_size.x);
+    let visible_bottom = outer_rect.max.y.min(monitor_size.y);
+    let visible_width = (visible_right - visible_left).max(0.0);
+    let visible_height = (visible_bottom - visible_top).max(0.0);
+
+    // Keep enough of the window visible to find and drag it, not merely one pixel.
+    visible_width >= 80.0 && visible_height >= 32.0
+}
