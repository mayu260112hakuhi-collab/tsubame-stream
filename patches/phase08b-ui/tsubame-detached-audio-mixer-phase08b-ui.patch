+pub fn rects_intersect(
+    a_pos: [f32; 2],
+    a_size: [f32; 2],
+    b_pos: [f32; 2],
+    b_size: [f32; 2],
+) -> bool {
+    let a_right = a_pos[0] + a_size[0];
+    let a_bottom = a_pos[1] + a_size[1];
+    let b_right = b_pos[0] + b_size[0];
+    let b_bottom = b_pos[1] + b_size[1];
+
+    a_pos[0] < b_right
+        && a_right > b_pos[0]
+        && a_pos[1] < b_bottom
+        && a_bottom > b_pos[1]
