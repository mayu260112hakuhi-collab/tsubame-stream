+fn mixer_meter_refresh_due(last_refresh: Option<Instant>, now: Instant) -> bool {
+    last_refresh
+        .map(|last| now.saturating_duration_since(last) >= Duration::from_millis(33))
+        .unwrap_or(true)
+}
