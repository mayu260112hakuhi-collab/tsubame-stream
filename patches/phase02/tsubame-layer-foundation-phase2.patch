 impl YaoyorozuApp {
+    fn allocate_layer_id(&mut self) -> LayerId {
+        let id = self.next_layer_id;
+        self.next_layer_id = self.next_layer_id.saturating_add(1);
+        id
+    }
+
+    fn layer_locked(&self, id: LayerId) -> bool {
+        self.layers
+            .iter()
+            .find(|layer| layer.id == id)
+            .map(|layer| layer.locked)
+            .unwrap_or(false)
+    }
+
+    fn replace_image_layer(&mut self, name: String) -> LayerId {
+        if let Some(old_id) = self.image_layer_id.take() {
+            self.layers.retain(|layer| layer.id != old_id);
+            if self.selected_layer == Some(old_id) {
+                self.selected_layer = None;
+            }
+        }
+
+        let id = self.allocate_layer_id();
+        self.layers.push(SceneLayer::new(id, LayerKind::Image, name));
+        self.image_layer_id = Some(id);
+        id
+    }
+
+    fn remove_image_layer_metadata(&mut self) {
+        if let Some(id) = self.image_layer_id.take() {
+            self.layers.retain(|layer| layer.id != id);
+            if self.selected_layer == Some(id) {
+                self.selected_layer = None;
+            }
+        }
+    }
