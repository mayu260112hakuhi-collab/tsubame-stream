 use std::path::{Path, PathBuf};
 
+
+pub type LayerId = u64;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum LayerKind {
+    FishOverlay,
+    Image,
+    Capture,
+    Camera,
+    Text,
+    Audio,
+    InputOverlay,
+    Browser,
+    Group,
+}
+
+impl LayerKind {
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::FishOverlay => "テスト",
+            Self::Image => "画像",
+            Self::Capture => "キャプチャ",
+            Self::Camera => "カメラ",
+            Self::Text => "テキスト",
+            Self::Audio => "音声",
+            Self::InputOverlay => "入力表示",
+            Self::Browser => "Web",
+            Self::Group => "グループ",
+        }
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct SceneLayer {
+    pub id: LayerId,
+    pub kind: LayerKind,
+    pub name: String,
+    pub locked: bool,
+}
+
+impl SceneLayer {
+    pub fn new(id: LayerId, kind: LayerKind, name: impl Into<String>) -> Self {
+        Self {
+            id,
+            kind,
+            name: name.into(),
+            locked: false,
+        }
+    }
+}
+
